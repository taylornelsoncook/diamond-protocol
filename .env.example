PORT=3000
DB_FILE=data/diamond.db
# Test mode lets you simulate declining cards, run billing on a future date and send webhooks to http:// URLs.
DP_TEST_MODE=true
# Owner account created by `npm run seed`
ADMIN_EMAIL=coach@diamondprotocol.local
ADMIN_PASSWORD=change-me-now

# Stripe. Leave blank to use built-in test payments. Use sk_test_... keys until you're ready for real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
# Your public address once deployed, e.g. https://app.diamondprotocol.com (used in card links sent to clients)
PUBLIC_URL=

# Business time zone for class times (IANA name)
BUSINESS_TZ=America/Chicago
# Email (parent sign-in codes, booking confirmations). Leave blank to log emails to the Outbox instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Diamond Protocol <coach@yourdomain.com>
# Text messages through Twilio. Leave blank to log texts under API & integrations → Texts instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, e.g. +15125550199, or a Messaging Service ID (MG...)
TWILIO_FROM=
# Only really text these numbers (comma list), e.g. on a staging copy
SMS_ONLY_TO=

# Hosting
# Set TRUST_PROXY=true when the app runs behind your host's HTTPS proxy (Render, Fly.io, Railway …).
TRUST_PROXY=false
# Where daily backups go (defaults to a "backups" folder next to the database) and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=30
# Off-site backups (optional): any S3-compatible storage. See DEPLOY.md → Backups.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=diamond-protocol/
# Encrypts each off-site copy. Keep it in your password manager: backups can't be restored without it.
BACKUP_PASSPHRASE=
# First start on a new server creates this owner (with ADMIN_EMAIL and ADMIN_PASSWORD above), who must choose a new password.
ADMIN_NAME=Owner
